# Copy to .env and fill in. Never commit the real .env.

SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True

# Redis is required for Celery (task queue). Free & local:
#   sudo apt install redis-server
#   redis-server   (or it may already run as a service)
CELERY_BROKER_URL=redis://localhost:6379/0

# Email — by default prints to the console (free, no setup needed).
# For real emails, use a free SMTP like Gmail App Passwords or Brevo (free tier):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@sitemonitor.local
